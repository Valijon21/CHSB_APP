# ==============================================================================
# CHSB Assessment Platform - Environment Variables Template
# ==============================================================================

# Database Connection (Neon.tech or Supabase Cloud PostgreSQL)
# Example: postgresql://username:password@ep-cool-butterfly-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Security / Authentication (required, at least 32 characters)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Password for the bootstrap accounts, at least 10 characters.
# Used only while the database has no users.
SEED_PASSWORD=

# Browser origins allowed to call the API from another domain (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required by docker-compose only
POSTGRES_PASSWORD=

# AI Diagnostic Engine (Optional: Google Gemini API Key)
GEMINI_API_KEY=

# Server Port (Set automatically by Render / Koyeb via $PORT)
PORT=8000
