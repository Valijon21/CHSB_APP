# ==============================================================================
# CHSB Assessment Platform - Environment Variables Template
# ==============================================================================

# PostgreSQL connection string (local, Neon, Supabase, ...). Required.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/chsb_db

# Security / Authentication (required, at least 32 characters)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Password for the bootstrap accounts, at least 10 characters.
# Used only while the database has no users.
SEED_PASSWORD=

# Browser origins allowed to call the API from another domain (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required by docker-compose only
POSTGRES_PASSWORD=

# Tests: a separate database whose name ends with _test. It is wiped on every run.
# TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/chsb_test

# AI Diagnostic Engine (Optional: Google Gemini API Key)
GEMINI_API_KEY=

# Optional tuning
LOG_LEVEL=INFO
DB_POOL_SIZE=5
# Behind a reverse proxy, the proxy addresses whose X-Forwarded-For is trusted
# FORWARDED_ALLOW_IPS=127.0.0.1

# Server Port (Set automatically by Render / Koyeb via $PORT)
PORT=8000
