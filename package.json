{
  "name": "chsb-platform",
  "private": true,
  "version": "2.0.0",
  "description": "CHSB Enterprise Multi-Tenant Assessment & School Intelligence Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "uvicorn backend.app.main:app --reload",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "lint:fix": "npm --prefix frontend run lint:fix",
    "test": "npm --prefix frontend run test",
    "test:frontend": "npm --prefix frontend run test",
    "test:watch": "npm --prefix frontend run test:watch",
    "test:backend": "pytest backend/tests",
    "dev:v2": "npm --prefix v2 run dev",
    "build:v2": "npm --prefix v2 run build",
    "test:v2": "npx tsx --test v2/tests/*.test.ts",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate"
  },
  "devDependencies": {
    "prisma": "^5.17.0"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0"
  }
}
