datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator client_py {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  regionId  String   @map("region_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  schools             School[]
  users               User[]
  classGroups         ClassGroup[]
  students            Student[]
  subjects            Subject[]
  curriculumResources CurriculumResource[]

  @@map("tenants")
}

model School {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  districtId    String   @map("district_id")
  schoolType    String   @default("comprehensive") @map("school_type")
  gradingPreset String   @default("MMTV_STANDARD") @map("grading_preset") // 'MMTV_STANDARD' (86/66/30) | 'SPECIALIZED' (86/71/56)
  studentCount  Int      @default(0) @map("student_count")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classGroups ClassGroup[]
  students    Student[]

  @@map("schools")
}

model User {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  username       String   @unique
  email          String?
  hashedPassword String   @map("hashed_password")
  fullName       String   @map("full_name")
  role           String   @default("TEACHER")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@map("users")
}

model ClassGroup {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  tenantId     String   @map("tenant_id")
  name         String
  gradeLevel   Int      @map("grade_level")
  shift        Int      @default(1)
  academicYear String   @default("2026-2027") @map("academic_year")
  studentCount Int      @default(0) @map("student_count")
  hasGroups    Boolean  @default(true) @map("has_groups")
  createdAt    DateTime @default(now()) @map("created_at")

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students Student[]

  @@map("class_groups")
}

model Student {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  classGroupId String   @map("class_group_id")
  tenantId     String   @map("tenant_id")
  rosterCode   String   @unique @map("roster_code")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  middleName   String?  @map("middle_name")
  gender       String   @default("M")
  birthDate    DateTime @map("birth_date")
  status       String   @default("ELIGIBLE")
  group        String?  @default("1-guruh") @map("group")
  emaktabId    String?  @map("emaktab_id")
  createdAt    DateTime @default(now()) @map("created_at")

  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup      ClassGroup          @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempts        AssessmentAttempt[]
  results         AssessmentResult[]
  formativeScores FormativeScore[]

  @@map("students")
}

model Assessment {
  id              String   @id @default(uuid())
  code            String   @unique
  title           String
  subject         String
  subjectCode     String?  @map("subject_code")
  gradeLevel      Int      @map("grade_level")
  quarter         Int      @default(1)
  academicYear    String   @default("2026-2027") @map("academic_year")
  assessmentType  String   @default("CHSB") @map("assessment_type") // 'BSB' | 'CHSB' | 'PROJECT'
  targetGroup     String?  @default("all") @map("target_group")
  durationMinutes Int      @default(45) @map("duration_minutes")
  totalQuestions  Int      @default(15) @map("total_questions")
  maxScore        Float    @default(40.0) @map("max_score")
  createdAt       DateTime @default(now()) @map("created_at")

  questions Question[]
  attempts  AssessmentAttempt[]

  @@map("assessments")
}

model Question {
  id               String @id @default(uuid())
  assessmentId     String @map("assessment_id")
  questionNumber   Int    @map("question_number")
  prompt           String
  taskType         String @default("multiple_choice") @map("task_type")
  optionsJson      String @map("options_json")
  correctOptionId  String @map("correct_option_id")
  subQuestionsJson String @default("[]") @map("sub_questions_json")
  rubricJson       String @default("[]") @map("rubric_json")
  bloomLevel       String @default("KNOWLEDGE") @map("bloom_level")
  difficulty       String @default("medium")
  points           Float  @default(2.5)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model AssessmentAttempt {
  id               String    @id @default(uuid())
  assessmentId     String    @map("assessment_id")
  studentId        String    @map("student_id")
  startedAt        DateTime  @default(now()) @map("started_at")
  submittedAt      DateTime? @map("submitted_at")
  answersJson      String    @default("{}") @map("answers_json")
  timeSpentSeconds Int       @default(0) @map("time_spent_seconds")
  status           String    @default("in_progress")
  absenceReason    String    @default("none") @map("absence_reason")
  reopenedBy       String?   @map("reopened_by")
  reopenedAt       DateTime? @map("reopened_at")

  assessment    Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  result        AssessmentResult?
  proctorEvents ProctorEvent[]

  @@map("assessment_attempts")
}

model AssessmentResult {
  id                String    @id @default(uuid())
  attemptId         String    @unique @map("attempt_id")
  studentId         String    @map("student_id")
  score             Float
  maxScore          Float     @map("max_score")
  percentage        Float
  grade             String
  status            String    @default("verified")
  rubricScoresJson  String    @default("{}") @map("rubric_scores_json")
  teacherFeedback   String?   @map("teacher_feedback")
  verifiedByTeacher Boolean   @default(false) @map("verified_by_teacher")
  gradedBy          String?   @map("graded_by")
  gradedAt          DateTime? @map("graded_at")
  submittedAt       DateTime  @default(now()) @map("submitted_at")

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("assessment_results")
}

model FormativeScore {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  studentId    String   @map("student_id")
  subjectCode  String   @map("subject_code")
  quarter      Int      @default(1)
  academicYear String   @default("2026-2027") @map("academic_year")
  classwork    Float    @default(0.0)
  homework     Float    @default(0.0)
  totalScore   Float    @default(0.0)
  recordedBy   String?  @map("recorded_by")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, subjectCode, quarter])
  @@map("formative_scores")
}

model ProctorEvent {
  id        String   @id @default(uuid())
  attemptId String   @map("attempt_id")
  studentId String   @map("student_id")
  eventType String   @map("event_type")
  severity  String   @default("info")
  message   String?
  extraData String?  @map("extra_data")
  createdAt DateTime @default(now()) @map("created_at")

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
  @@map("proctor_events")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String
  detailsJson String?  @map("details_json")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Subject {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  description String?
  gradeLevels String   @default("5,6,7,8,9,10,11") @map("grade_levels")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("subjects")
}

model CurriculumResource {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  subjectCode   String   @map("subject_code")
  gradeLevel    Int      @map("grade_level")
  quarter       Int      @default(1)
  lessonNumber  Int      @default(1) @map("lesson_number")
  title         String
  topic         String
  resourceType  String   @map("resource_type") // 'PRESENTATION', 'WORKSHEET', 'WORKBOOK', 'SOLUTION'
  description   String?
  contentJson   String   @default("{}") @map("content_json")
  fileUrl       String?  @map("file_url")
  downloadCount Int      @default(0) @map("download_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectCode, gradeLevel, quarter])
  @@map("curriculum_resources")
}

model AssessmentSolution {
  id                 String   @id @default(uuid())
  assessmentId       String   @map("assessment_id")
  questionId         String   @map("question_id")
  variantNumber      Int      @default(1) @map("variant_number")
  stepByStepSolution String   @map("step_by_step_solution")
  solutionFormulas   String?  @map("solution_formulas")
  rubricCriteriaJson String   @default("[]") @map("rubric_criteria_json")
  authorNote         String?  @map("author_note")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([assessmentId, questionId])
  @@map("assessment_solutions")
}
